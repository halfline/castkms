[Unit]
Description=Attach a castkms virtual monitor
After=systemd-udevd.service
ConditionPathExists=/usr/local/lib/castkms/castkms.ko
ConditionPathExists=/usr/local/libexec/castkms-attach
ConditionPathExists=/usr/local/libexec/castkms-grant-launch
ConditionPathExists=/usr/local/libexec/castkms-module-dependencies

[Service]
Type=simple
# System units cannot insmod or exec files labeled user_home_t.
SELinuxContext=system_u:system_r:unconfined_service_t:s0
Environment=PATH=/usr/sbin:/usr/bin
Environment=CASTKMS_KO=/usr/local/lib/castkms/castkms.ko
Environment=CASTKMS_ATTACH=/usr/local/libexec/castkms-attach
Environment=CASTKMS_GRANT_LAUNCH=/usr/local/libexec/castkms-grant-launch
Environment=CASTKMS_MODULE_DEPENDENCIES=/usr/local/libexec/castkms-module-dependencies
ExecStart=/usr/local/libexec/castkms-attach-monitor /home/castkms/castkms
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical.target
